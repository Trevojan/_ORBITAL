<Project Sdk="Microsoft.NET.Sdk.Web">

	<!--
	  _PANEL: the one project per <APP>_ORBITAL that is allowed to know everything.
	  It owns authentication and composition; it owns no business rules.
	  This is also the only executable in API_ORBITAL.
	-->
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<RootNamespace>API_PANEL</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<!-- Its own app's _DRIVE... -->
		<ProjectReference Include="..\SATELLITE_DRIVE\SATELLITE_DRIVE.csproj" />
		<!-- ...plus the other apps it composes. Note they never reference back. -->
		<ProjectReference Include="..\..\MIDDLEWARE_ORBITAL\RELAY_CORE\RELAY_CORE.csproj" />
		<ProjectReference Include="..\..\DATA_ORBITAL\VAULT_CORE\VAULT_CORE.csproj" />
	</ItemGroup>

</Project>
