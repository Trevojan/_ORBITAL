@using BEACON_ENGINE.Viewport
@using BEACON_CORE.Readout
@inject IViewportOperations Viewports
@inject IReadoutSource Readings
@inject IReadoutOperations Readouts

<div class="beacon" style="max-width: @(_columns * 320)px">
    <h1>@Title</h1>

    <p class="muted">Layout: <strong>@_viewportClass</strong> · @_columns column(s)</p>

    <div class="reading">
        <p class="mono">@Readouts.Describe(_readout)</p>
        <p class="muted">Uplink: <strong>@_readoutState</strong></p>
    </div>

    <button @onclick="Refresh" disabled="@_isBusy">
        @(_isBusy ? "Contacting…" : "Refresh from API")
    </button>
</div>

@code
{
    private const string Title = "ORBITAL — Beacon";

    private EViewportClass _viewportClass = EViewportClass.Unknown;
    private int _columns = 1;
    private EReadoutState _readoutState = EReadoutState.Empty;
    private MReadout _readout = MReadout.Empty;
    private bool _isBusy;

    /// <summary>
    /// The browser owns the viewport, so the host measures it and passes it in. The page
    /// never reads the window itself — that keeps every layout rule in the engine, where
    /// it can be proven without a browser.
    /// </summary>
    [Parameter]
    public int WidthPx { get; set; } = StrViewport.MinUsableWidthPx;

    protected override async Task OnInitializedAsync()
    {
        var measured = Viewports.Normalize(MViewport.Measured(WidthPx, 0));

        _viewportClass = measured.Class;
        _columns = Viewports.ColumnsThatFit(measured);

        await Refresh();
    }

    private async Task Refresh()
    {
        _isBusy = true;

        _readout = await Readings.LatestAsync();
        _readoutState = Readouts.StateOf(_readout, DateTimeOffset.UtcNow);

        _isBusy = false;
    }
}
